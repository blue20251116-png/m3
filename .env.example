# OpenAI (본문/제목 생성)
OPENAI_API_KEY=

# 네이버 검색 오픈API (선택)
# 직접 추출 → Browser Bridge까지 실패했을 때 마지막 검색 폴백에 사용
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Browser Bridge가 Chrome 응답을 기다리는 시간(ms)
M3_BROWSER_BRIDGE_TIMEOUT_MS=45000

# Browser Bridge 인증에도 동일하게 사용 (비워두면 인증 없음)
ADMIN_PASSWORD=

PORT=4300
